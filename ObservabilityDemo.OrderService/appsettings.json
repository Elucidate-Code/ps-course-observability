{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Warning",
      "Microsoft.AspNetCore.Http.Connections": "Warning",
      "ObservabilityDemo": "Debug"
    }
  },
  "AllowedHosts": "*",

  "Otlp": {
    "Backend": "Aspire",
    "Aspire": {
      "Endpoint": "http://localhost:18889",
      "Headers": "x-otlp-api-key=demo-key"
    },
    "GrafanaStack": {
      "Endpoint": "http://localhost:4318",
      "Protocol": "HttpProtobuf"
    },
    "AzureMonitor": {
      "Protocol": "HttpProtobuf",
      "TracesEndpoint": "",
      "MetricsEndpoint": "",
      "LogsEndpoint": "",
      "Headers": ""
    }
  }
}
